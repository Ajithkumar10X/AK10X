<UserControl x:Class="WindowsApp.MarketProfile.Views.FiftyChartsMarketProfileView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="850" d:DesignWidth="1280"
             Background="#070D10" Foreground="#E2E8F0"
             FontFamily="Segoe UI">

    <UserControl.Resources>
        <!-- 50Charts Custom Styles -->
        <Style x:Key="HeaderLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="#808080"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="HeaderValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#CA8A29"/>
            <Setter Property="Margin" Value="0,0,14,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="FiftyChartsButton" TargetType="Button">
            <Setter Property="Background" Value="#122229"/>
            <Setter Property="Foreground" Value="#E2E8F0"/>
            <Setter Property="BorderBrush" Value="#254250"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="4" 
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#1D3845"/>
                                <Setter Property="BorderBrush" Value="#38BDF8"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#0E1A20"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FiftyChartsToggleButton" TargetType="CheckBox">
            <Setter Property="Foreground" Value="#94A3B8"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="5,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="border" Background="#0E1A20" BorderBrush="#1D3845" BorderThickness="1" 
                                CornerRadius="4" Padding="7,3">
                            <StackPanel Orientation="Horizontal">
                                <Border x:Name="checkIndicator" Width="10" Height="10" CornerRadius="2" 
                                        Background="#162730" BorderBrush="#334155" BorderThickness="1" Margin="0,0,5,0">
                                    <Path x:Name="checkMark" Data="M 1 4 L 4 7 L 9 1" Stroke="#38BDF8" StrokeThickness="1.5" 
                                          Visibility="Collapsed"/>
                                </Border>
                                <ContentPresenter VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#0284C7"/>
                                <Setter TargetName="border" Property="Background" Value="#0C2433"/>
                                <Setter TargetName="checkIndicator" Property="Background" Value="#0284C7"/>
                                <Setter TargetName="checkMark" Property="Visibility" Value="Visible"/>
                                <Setter Property="Foreground" Value="#F0F9FF"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#38BDF8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <!-- Row 0: AmiBroker-style Multi-Chart Tab Bar (N number of charts) -->
            <RowDefinition Height="Auto"/>
            <!-- Row 1: 50Charts Settings & Merge/Unmerge Toolbar -->
            <RowDefinition Height="Auto"/>
            <!-- Row 2: Main Profile Chart Surface -->
            <RowDefinition Height="*"/>
            <!-- Row 3: AmiBroker Sheet Tabs & Timeline Bar -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Row 0: AmiBroker-style Multi-Chart Tab Bar -->
        <Border Grid.Row="0" Background="#050B0E" BorderBrush="#162730" BorderThickness="0,0,0,1" Padding="6,3">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Dynamic Chart Tabs List -->
                <ScrollViewer Grid.Column="0" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="ChartTabsPanel" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Chart Tabs populated dynamically in code-behind -->
                    </StackPanel>
                </ScrollViewer>

                <!-- Add New Chart Button & AccelPix Status -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="AddChartBtn" Content="➕ Add Chart" Style="{StaticResource FiftyChartsButton}" 
                            Background="#1E3A8A" BorderBrush="#3B82F6" Foreground="#FFFFFF"
                            Click="AddChartBtn_Click" Margin="0,0,8,0" ToolTip="Open a new symbol chart tab"/>
                    
                    <Popup x:Name="AddChartPopup" Placement="Bottom" PlacementTarget="{Binding ElementName=AddChartBtn}" 
                           StaysOpen="False" AllowsTransparency="True">
                        <Border Background="#0A141A" BorderBrush="#254250" BorderThickness="1" CornerRadius="6" Padding="6" Margin="0,4,0,0">
                            <StackPanel x:Name="SymbolPopupList" Width="180">
                                <!-- Populated dynamically with symbols -->
                            </StackPanel>
                        </Border>
                    </Popup>

                    <!-- Market Status Badge (Closed / Open / Replay) -->
                    <Border x:Name="MarketStatusBadge" Background="#1E293B" BorderBrush="#334155" BorderThickness="1" CornerRadius="4" 
                            Padding="8,3" Margin="0,0,6,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse x:Name="MarketStatusDot" Width="7" Height="7" Fill="#64748B" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="MarketStatusText" Text="Market Closed (NSE)" Foreground="#94A3B8" FontSize="10" FontWeight="Bold"/>
                        </StackPanel>
                    </Border>

                    <!-- Replay / Simulate Live Toggle -->
                    <Button x:Name="SimulateReplayBtn" Content="▶ Test Replay" Style="{StaticResource FiftyChartsButton}" 
                            Click="SimulateReplayBtn_Click" ToolTip="Simulate live AccelPix tick feed after market hours"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Row 1: 50Charts Settings & Merge/Unmerge Toolbar -->
        <Border Grid.Row="1" Background="#0A1217" BorderBrush="#162730" BorderThickness="0,0,0,1" Padding="8,4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Left: View Mode (Dual vs Merged vs Split) & Multi-Day Merge/Unmerge -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Mode Radio Buttons -->
                    <Border Background="#122229" BorderBrush="#254250" BorderThickness="1" CornerRadius="4" Padding="2" Margin="0,0,6,0">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="DualRadio" Content="🌟 50Charts Mode" IsChecked="True" 
                                         Foreground="#E2E8F0" FontSize="11" FontWeight="Bold" Margin="4,2" 
                                         Cursor="Hand" Checked="ProfileMode_Changed"/>
                            <RadioButton x:Name="MergedRadio" Content="📊 Merged" 
                                         Foreground="#E2E8F0" FontSize="11" FontWeight="Bold" Margin="4,2" 
                                         Cursor="Hand" Checked="ProfileMode_Changed"/>
                            <RadioButton x:Name="SplitRadio" Content="🔀 Split (A-M)" 
                                         Foreground="#E2E8F0" FontSize="11" FontWeight="Bold" Margin="4,2" 
                                         Cursor="Hand" Checked="ProfileMode_Changed"/>
                        </StackPanel>
                    </Border>

                    <!-- Multi-Day Merge / Unmerge Actions -->
                    <Border Background="#122229" BorderBrush="#254250" BorderThickness="1" CornerRadius="4" Padding="2" Margin="0,0,6,0">
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="MergeDaysBtn" Content="🔗 Merge Days" Style="{StaticResource FiftyChartsButton}" 
                                    Click="MergeDaysBtn_Click" ToolTip="Merge visible daily profiles into a single composite profile"/>
                            <Button x:Name="UnmergeDaysBtn" Content="✂️ Unmerge All" Style="{StaticResource FiftyChartsButton}" 
                                    Click="UnmergeDaysBtn_Click" ToolTip="Restore separate daily market profiles"/>
                        </StackPanel>
                    </Border>

                    <!-- Feature Toggles -->
                    <CheckBox x:Name="ToggleVa" Content="Value Area" IsChecked="True" Style="{StaticResource FiftyChartsToggleButton}" Click="Toggle_Click"/>
                    <CheckBox x:Name="ToggleIb" Content="IB (A+B)" IsChecked="True" Style="{StaticResource FiftyChartsToggleButton}" Click="Toggle_Click"/>
                    <CheckBox x:Name="TogglePoc" Content="POC / VPOC" IsChecked="True" Style="{StaticResource FiftyChartsToggleButton}" Click="Toggle_Click"/>
                    <CheckBox x:Name="ToggleSp" Content="Single Prints" IsChecked="True" Style="{StaticResource FiftyChartsToggleButton}" Click="Toggle_Click"/>
                    <CheckBox x:Name="ToggleVp" Content="Volume Profile" IsChecked="True" Style="{StaticResource FiftyChartsToggleButton}" Click="Toggle_Click"/>
                </StackPanel>

                <!-- Center Pill Summary (Clean, compact, no cutoffs) -->
                <Border Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                        Background="#0D1A22" BorderBrush="#1E3845" BorderThickness="1" CornerRadius="4" Padding="10,3">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Symbol: " Foreground="#808080" FontSize="11"/>
                        <TextBlock x:Name="ActiveSymbolHeader" Text="HDFCLIFE_I" Foreground="#FFFFFF" FontSize="11" FontWeight="Bold" Margin="0,0,10,0"/>
                        <TextBlock Text="POC: " Foreground="#808080" FontSize="11"/>
                        <TextBlock x:Name="TodayPocText" Text="519.50" Foreground="#FACC15" FontSize="11" FontWeight="Bold" Margin="0,0,10,0"/>
                        <TextBlock Text="VA: " Foreground="#808080" FontSize="11"/>
                        <TextBlock x:Name="TodayVaSummaryText" Text="518 - 522" Foreground="#38BDF8" FontSize="11" FontWeight="Bold" Margin="0,0,10,0"/>
                        <TextBlock Text="LTP: " Foreground="#808080" FontSize="11"/>
                        <TextBlock x:Name="LiveLtpText" Text="521.00" Foreground="#60A5FA" FontSize="11" FontWeight="Bold"/>
                    </StackPanel>
                </Border>

                <!-- Right Toolbar -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="ZoomInBtn" Content="🔍 Zoom (+)" Style="{StaticResource FiftyChartsButton}" Click="ZoomIn_Click"/>
                    <Button x:Name="ZoomOutBtn" Content="🔍 Zoom (-)" Style="{StaticResource FiftyChartsButton}" Click="ZoomOut_Click"/>
                    <Button x:Name="ResetZoomBtn" Content="⟲ Reset Zoom" Style="{StaticResource FiftyChartsButton}" Click="ResetZoom_Click"/>
                    <Button x:Name="RefreshDataBtn" Content="🔄 Refresh Data" Style="{StaticResource FiftyChartsButton}" Click="RefreshData_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Row 2: Main Chart Surface -->
        <Grid Grid.Row="2" Background="#070D10">
            <Grid.ColumnDefinitions>
                <!-- Main TPO Letter Profile Canvas -->
                <ColumnDefinition Width="*"/>
                <!-- Right Price Ladder & Reference Lines Axis -->
                <ColumnDefinition Width="90"/>
            </Grid.ColumnDefinitions>

            <!-- Scrollable Chart Canvas -->
            <ScrollViewer x:Name="ChartScrollViewer" Grid.Column="0" 
                          HorizontalScrollBarVisibility="Hidden" 
                          VerticalScrollBarVisibility="Hidden" 
                          Background="#070D10"
                          PreviewMouseWheel="ChartScrollViewer_PreviewMouseWheel">
                <Grid x:Name="ProfileContainerGrid" Background="#070D10" 
                      MouseDown="ProfileContainerGrid_MouseDown"
                      MouseMove="ProfileContainerGrid_MouseMove"
                      MouseUp="ProfileContainerGrid_MouseUp"
                      Cursor="Cross">
                    <!-- Custom WPF Canvas Rendering Target -->
                    <Canvas x:Name="ProfileDrawingCanvas" Background="#070D10"/>

                    <!-- Transparent Floating HUD (Top-Left 4-Line exact 50Charts display) -->
                    <Border Margin="10,6,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" IsHitTestVisible="False"
                            Background="#D9070D10" CornerRadius="3" Padding="6,3">
                    <StackPanel>
                        <TextBlock x:Name="HudLine1" Text="Market Profile: HDFCLIFE_I, TPOSize: 0.50 (Auto &amp; Real-time), Distribution: Daily, TPO Interval: 30 min" 
                                   Foreground="#E69138" FontSize="11" FontWeight="SemiBold" FontFamily="Segoe UI"/>
                        <TextBlock x:Name="HudLine2" Text="30 min OneTime framing Down (3)" 
                                   Foreground="#D4A017" FontSize="11" FontWeight="SemiBold" FontFamily="Segoe UI" Margin="0,1,0,0"/>
                        <TextBlock x:Name="HudLine3" Text="30 min Inside Bar (L)" 
                                   Foreground="#D4A017" FontSize="11" FontWeight="SemiBold" FontFamily="Segoe UI" Margin="0,1,0,0"/>
                        <TextBlock x:Name="HudLine4" Margin="0,1,0,0" FontSize="11" FontWeight="Bold" FontFamily="Segoe UI">
                            <Run x:Name="HudOhlcPrefix" Text="O: 523.90, H: 527.50, L: 512.30, C: 521.00 " Foreground="#D4A017"/>
                            <Run x:Name="HudChangeText" Text="(-5.15 : -0.99%)" Foreground="#FF3333"/>
                            <Run x:Name="HudVolText" Text=", V: 32,450K" Foreground="#D4A017"/>
                        </TextBlock>
                    </StackPanel>
                    </Border>

                    <!-- Top-Right 50CHARTS Logo -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,10,16,0" IsHitTestVisible="False">
                        <Path Data="M0,0 L6,0 L9,5 L6,10 L0,10 L3,5 Z" Fill="#FFFFFF" Width="10" Height="10" Stretch="Fill" Margin="0,0,5,0" VerticalAlignment="Center"/>
                        <TextBlock Text="50CHARTS" FontSize="11" FontWeight="ExtraBold" Foreground="#FFFFFF" FontFamily="Segoe UI"/>
                    </StackPanel>
                </Grid>
            </ScrollViewer>

            <!-- Right Price Axis (LTP, VAH, POC, VAL, IB High/Low, Ticks) -->
            <Border Grid.Column="1" Background="#0A141A" BorderBrush="#162730" BorderThickness="1,0,0,0">
                <Grid>
                    <Canvas x:Name="PriceAxisCanvas" Background="Transparent" ClipToBounds="True"/>
                </Grid>
            </Border>

            <!-- Crosshair Hover Overlay Tooltip -->
            <Border x:Name="HoverTooltip" Grid.Column="0" Visibility="Collapsed" 
                    Background="#122229" BorderBrush="#38BDF8" BorderThickness="1" 
                    CornerRadius="6" Padding="10,6" IsHitTestVisible="False"
                    HorizontalAlignment="Left" VerticalAlignment="Top">
                <StackPanel>
                    <TextBlock x:Name="HoverPriceText" Text="Price: 521.00" FontWeight="Bold" Foreground="#FFFF00" FontSize="11"/>
                    <TextBlock x:Name="HoverTpoCountText" Text="TPO Count: 11" Foreground="#E2E8F0" FontSize="10"/>
                    <TextBlock x:Name="HoverPeriodsText" Text="Periods: A B C D E F G H I J K" Foreground="#38BDF8" FontSize="10"/>
                    <TextBlock x:Name="HoverVolumeText" Text="Volume: 42,850" Foreground="#94A3B8" FontSize="10"/>
                    <TextBlock x:Name="HoverStatusText" Text="Status: POC (Point of Control) | Value Area" Foreground="#10B981" FontSize="10" FontWeight="SemiBold"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Row 3: AmiBroker Style Sheet Tabs & Timeline Bar -->
        <Border Grid.Row="3" Background="#0A141A" BorderBrush="#162730" BorderThickness="0,1,0,0" Padding="8,4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Left: Sheet Tabs & Navigation -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#122229" BorderBrush="#254250" BorderThickness="1" CornerRadius="3" Padding="4,2" Margin="0,0,2,0" Cursor="Hand">
                        <TextBlock Text="|&lt;&lt;" Foreground="#94A3B8" FontSize="10" FontWeight="Bold"/>
                    </Border>
                    <Border Background="#122229" BorderBrush="#254250" BorderThickness="1" CornerRadius="3" Padding="4,2" Margin="0,0,2,0" Cursor="Hand">
                        <TextBlock Text="&lt;&lt;" Foreground="#94A3B8" FontSize="10" FontWeight="Bold"/>
                    </Border>
                    <Border Background="#122229" BorderBrush="#254250" BorderThickness="1" CornerRadius="3" Padding="4,2" Margin="0,0,2,0" Cursor="Hand">
                        <TextBlock Text="&gt;&gt;" Foreground="#94A3B8" FontSize="10" FontWeight="Bold"/>
                    </Border>
                    <Border Background="#122229" BorderBrush="#254250" BorderThickness="1" CornerRadius="3" Padding="4,2" Margin="0,0,8,0" Cursor="Hand">
                        <TextBlock Text="&gt;&gt;|" Foreground="#94A3B8" FontSize="10" FontWeight="Bold"/>
                    </Border>

                    <!-- Sheet 1 to Sheet 8 Tabs -->
                    <Border Background="#1E3A8A" BorderBrush="#3B82F6" BorderThickness="1" CornerRadius="3" Padding="8,3" Margin="0,0,2,0" Cursor="Hand">
                        <TextBlock Text="Sheet 1" Foreground="#FFFFFF" FontSize="10" FontWeight="Bold"/>
                    </Border>
                    <Border Background="#122229" BorderBrush="#254250" BorderThickness="1" CornerRadius="3" Padding="8,3" Margin="0,0,2,0" Cursor="Hand">
                        <TextBlock Text="Sheet 2" Foreground="#94A3B8" FontSize="10"/>
                    </Border>
                    <Border Background="#122229" BorderBrush="#254250" BorderThickness="1" CornerRadius="3" Padding="8,3" Margin="0,0,2,0" Cursor="Hand">
                        <TextBlock Text="Sheet 3" Foreground="#94A3B8" FontSize="10"/>
                    </Border>
                    <Border Background="#122229" BorderBrush="#254250" BorderThickness="1" CornerRadius="3" Padding="8,3" Margin="0,0,2,0" Cursor="Hand">
                        <TextBlock Text="Sheet 4" Foreground="#94A3B8" FontSize="10"/>
                    </Border>
                    <Border Background="#122229" BorderBrush="#254250" BorderThickness="1" CornerRadius="3" Padding="8,3" Margin="0,0,2,0" Cursor="Hand">
                        <TextBlock Text="Sheet 5" Foreground="#94A3B8" FontSize="10"/>
                    </Border>
                    <Border Background="#122229" BorderBrush="#254250" BorderThickness="1" CornerRadius="3" Padding="8,3" Margin="0,0,2,0" Cursor="Hand">
                        <TextBlock Text="Sheet 6" Foreground="#94A3B8" FontSize="10"/>
                    </Border>
                    <Border Background="#122229" BorderBrush="#254250" BorderThickness="1" CornerRadius="3" Padding="8,3" Margin="0,0,2,0" Cursor="Hand">
                        <TextBlock Text="Sheet 7" Foreground="#94A3B8" FontSize="10"/>
                    </Border>
                    <Border Background="#122229" BorderBrush="#254250" BorderThickness="1" CornerRadius="3" Padding="8,3" Margin="0,0,2,0" Cursor="Hand">
                        <TextBlock Text="Sheet 8" Foreground="#94A3B8" FontSize="10"/>
                    </Border>
                </StackPanel>

                <!-- Center: Session Metrics Cards -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Border Background="#122229" CornerRadius="4" Padding="6,2" Margin="3,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Open Type: " Foreground="#808080" FontSize="10"/>
                            <TextBlock x:Name="SummaryOpenType" Text="Open Below PDVA (OAOR)" Foreground="#F8FAFC" FontSize="10" FontWeight="Bold"/>
                        </StackPanel>
                    </Border>
                    <Border Background="#122229" CornerRadius="4" Padding="6,2" Margin="3,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Rotational Factor: " Foreground="#808080" FontSize="10"/>
                            <TextBlock x:Name="SummaryRotFactor" Text="-4 (Bearish)" Foreground="#EF4444" FontSize="10" FontWeight="Bold"/>
                        </StackPanel>
                    </Border>
                    <Border Background="#122229" CornerRadius="4" Padding="6,2" Margin="3,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="IB Status: " Foreground="#808080" FontSize="10"/>
                            <TextBlock x:Name="SummaryIbStatus" Text="Breakout Down" Foreground="#38BDF8" FontSize="10" FontWeight="Bold"/>
                        </StackPanel>
                    </Border>
                    <Border Background="#122229" CornerRadius="4" Padding="6,2" Margin="3,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Extremes: " Foreground="#808080" FontSize="10"/>
                            <TextBlock x:Name="SummaryPoorStatus" Text="Clean Taper" Foreground="#A855F7" FontSize="10" FontWeight="Bold"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Right: Profile Range & Total TPOs -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Day Range: " Foreground="#808080" FontSize="10"/>
                    <TextBlock x:Name="SummaryRangeText" Text="15.2 pts" Foreground="#CA8A29" FontSize="10" FontWeight="Bold" Margin="0,0,10,0"/>
                    <TextBlock Text="Total TPOs: " Foreground="#808080" FontSize="10"/>
                    <TextBlock x:Name="SummaryTotalTpos" Text="176" Foreground="#38BDF8" FontSize="10" FontWeight="Bold"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
