                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="26"/><RowDefinition Height="26"/><RowDefinition Height="26"/><RowDefinition Height="26"/>
                                        <RowDefinition Height="26"/><RowDefinition Height="26"/><RowDefinition Height="26"/><RowDefinition Height="26"/>
                                        <RowDefinition Height="26"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Mode" Style="{StaticResource Nt8PropLabel}"/>
                                    <ComboBox x:Name="PropVpMode" Grid.Row="0" Grid.Column="1" Style="{StaticResource DarkComboBox}" Height="23">
                                        <ComboBoxItem Content="Daily" IsSelected="True"/><ComboBoxItem Content="Session"/>
                                    </ComboBox>

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="POC: enable" Style="{StaticResource Nt8PropLabel}"/>
                                    <CheckBox x:Name="PropVpPocEnable" Grid.Row="1" Grid.Column="1" IsChecked="False" VerticalAlignment="Center" Margin="4,0,0,0"/>

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="POC: developing" Style="{StaticResource Nt8PropLabel}"/>
                                    <CheckBox x:Name="PropVpPocDeveloping" Grid.Row="2" Grid.Column="1" IsChecked="True" VerticalAlignment="Center" Margin="4,0,0,0"/>

                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="▶ POC: line" Style="{StaticResource Nt8PropLabel}"/>
                                    <TextBox Grid.Row="3" Grid.Column="1" Text="Solid, 2px" Style="{StaticResource Nt8PropTextBox}" IsReadOnly="True"/>

                                    <TextBlock Grid.Row="4" Grid.Column="0" Text="VA: enable" Style="{StaticResource Nt8PropLabel}"/>
                                    <CheckBox x:Name="PropVpVaEnable" Grid.Row="4" Grid.Column="1" IsChecked="True" VerticalAlignment="Center" Margin="4,0,0,0"/>

                                    <TextBlock Grid.Row="5" Grid.Column="0" Text="VA: developing" Style="{StaticResource Nt8PropLabel}"/>
                                    <CheckBox x:Name="PropVpVaDeveloping" Grid.Row="5" Grid.Column="1" IsChecked="True" VerticalAlignment="Center" Margin="4,0,0,0"/>

                                    <TextBlock Grid.Row="6" Grid.Column="0" Text="VA: %" Style="{StaticResource Nt8PropLabel}"/>
                                    <TextBox x:Name="PropVpVaPercent" Grid.Row="6" Grid.Column="1" Text="68" Style="{StaticResource Nt8PropTextBox}"/>

                                    <TextBlock Grid.Row="7" Grid.Column="0" Text="▶ VA: line" Style="{StaticResource Nt8PropLabel}"/>
                                    <TextBox Grid.Row="7" Grid.Column="1" Text="Solid, 2px" Style="{StaticResource Nt8PropTextBox}" IsReadOnly="True"/>

                                    <TextBlock Grid.Row="8" Grid.Column="0" Text="Session Profile: show" Style="{StaticResource Nt8PropLabel}"/>
                                    <CheckBox x:Name="PropVpSessionProfileShow" Grid.Row="8" Grid.Column="1" IsChecked="True" VerticalAlignment="Center" Margin="4,0,0,0"/>
                                </Grid>
                            </Expander>

                            <!-- 12. Notifications -->
                            <Expander Header="▶ Notifications" IsExpanded="False" Style="{StaticResource Nt8PropertyExpander}">
                                <Grid Margin="4,2">
                                    <TextBlock Text="Alert notifications and sound triggers active" Foreground="#888888" FontSize="10.5" Margin="16,4"/>
                                </Grid>
                            </Expander>

                            <!-- 13. Levels -->
                            <Expander Header="Levels" IsExpanded="False" Style="{StaticResource Nt8PropertyExpander}">
                                <Grid Margin="4,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="200"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="26"/><RowDefinition Height="26"/><RowDefinition Height="26"/><RowDefinition Height="26"/>
                                        <RowDefinition Height="26"/><RowDefinition Height="26"/><RowDefinition Height="26"/><RowDefinition Height="26"/>
                                        <RowDefinition Height="26"/><RowDefinition Height="26"/><RowDefinition Height="26"/><RowDefinition Height="26"/>
                                        <RowDefinition Height="26"/><RowDefinition Height="26"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Enable" Style="{StaticResource Nt8PropLabel}"/>
                                    <CheckBox x:Name="PropLevelsEnable" Grid.Row="0" Grid.Column="1" IsChecked="False" VerticalAlignment="Center" Margin="4,0,0,0"/>

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="▶ Support level" Style="{StaticResource Nt8PropLabel}"/>
                                    <TextBox Grid.Row="1" Grid.Column="1" Text="Solid, 10px" Style="{StaticResource Nt8PropTextBox}" IsReadOnly="True"/>

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="▶ Resistance level" Style="{StaticResource Nt8PropLabel}"/>
                                    <TextBox Grid.Row="2" Grid.Column="1" Text="Solid, 10px" Style="{StaticResource Nt8PropTextBox}" IsReadOnly="True"/>

                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Value position" Style="{StaticResource Nt8PropLabel}"/>
                                    <ComboBox x:Name="PropLevelsValuePosition" Grid.Row="3" Grid.Column="1" Style="{StaticResource DarkComboBox}" Height="23">
                                        <ComboBoxItem Content="Right" IsSelected="True"/><ComboBoxItem Content="Left"/>
                                    </ComboBox>

                                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Value/Label color" Style="{StaticResource Nt8PropLabel}"/>
                                    <ComboBox x:Name="PropLevelsValueColor" Grid.Row="4" Grid.Column="1" Style="{StaticResource DarkComboBox}" Height="23">
                                        <ComboBoxItem IsSelected="True"><StackPanel Orientation="Horizontal"><Border Width="16" Height="10" Background="#D3D3D3" BorderBrush="#000000" BorderThickness="1" Margin="0,0,6,0"/><TextBlock Text="LightGray"/></StackPanel></ComboBoxItem>
                                        <ComboBoxItem><StackPanel Orientation="Horizontal"><Border Width="16" Height="10" Background="#FFFFFF" BorderBrush="#000000" BorderThickness="1" Margin="0,0,6,0"/><TextBlock Text="White"/></StackPanel></ComboBoxItem>
                                    </ComboBox>

                                    <TextBlock Grid.Row="5" Grid.Column="0" Text="▶ Value/Label font" Style="{StaticResource Nt8PropLabel}"/>
                                    <TextBox Grid.Row="5" Grid.Column="1" Text="Arial, 10px" Style="{StaticResource Nt8PropTextBox}" IsReadOnly="True"/>

                                    <TextBlock Grid.Row="6" Grid.Column="0" Text="Alert" Style="{StaticResource Nt8PropLabel}"/>
                                    <CheckBox x:Name="PropLevelsAlert" Grid.Row="6" Grid.Column="1" IsChecked="True" VerticalAlignment="Center" Margin="4,0,0,0"/>

                                    <TextBlock Grid.Row="7" Grid.Column="0" Text="Alert on" Style="{StaticResource Nt8PropLabel}"/>
                                    <ComboBox x:Name="PropLevelsAlertOn" Grid.Row="7" Grid.Column="1" Style="{StaticResource DarkComboBox}" Height="23">
                                        <ComboBoxItem Content="LevelCross" IsSelected="True"/><ComboBoxItem Content="Touch"/>
                                    </ComboBox>

                                    <TextBlock Grid.Row="8" Grid.Column="0" Text="Rearm" Style="{StaticResource Nt8PropLabel}"/>
                                    <CheckBox x:Name="PropLevelsRearm" Grid.Row="8" Grid.Column="1" IsChecked="True" VerticalAlignment="Center" Margin="4,0,0,0"/>

                                    <TextBlock Grid.Row="9" Grid.Column="0" Text="Rearm interval, sec" Style="{StaticResource Nt8PropLabel}"/>
                                    <TextBox x:Name="PropLevelsRearmInterval" Grid.Row="9" Grid.Column="1" Text="5" Style="{StaticResource Nt8PropTextBox}"/>

                                    <TextBlock Grid.Row="10" Grid.Column="0" Text="Sound" Style="{StaticResource Nt8PropLabel}"/>
                                    <TextBox x:Name="PropLevelsSound" Grid.Row="10" Grid.Column="1" Text="crossed.wav" Style="{StaticResource Nt8PropTextBox}"/>

                                    <TextBlock Grid.Row="11" Grid.Column="0" Text="Add/remove: Mouse L..." Style="{StaticResource Nt8PropLabel}"/>
                                    <ComboBox x:Name="PropLevelsAddRemoveKey" Grid.Row="11" Grid.Column="1" Style="{StaticResource DarkComboBox}" Height="23">
                                        <ComboBoxItem Content="LeftShift" IsSelected="True"/><ComboBoxItem Content="LeftCtrl"/>
                                    </ComboBox>

                                    <TextBlock Grid.Row="12" Grid.Column="0" Text="Modify: Mouse Left +" Style="{StaticResource Nt8PropLabel}"/>
                                    <ComboBox x:Name="PropLevelsModifyKey" Grid.Row="12" Grid.Column="1" Style="{StaticResource DarkComboBox}" Height="23">
                                        <ComboBoxItem Content="LeftAlt" IsSelected="True"/><ComboBoxItem Content="LeftShift"/>
                                    </ComboBox>

                                    <TextBlock Grid.Row="13" Grid.Column="0" Text="Drag with Mouse" Style="{StaticResource Nt8PropLabel}"/>
                                    <CheckBox x:Name="PropLevelsDragWithMouse" Grid.Row="13" Grid.Column="1" IsChecked="True" VerticalAlignment="Center" Margin="4,0,0,0"/>
                                </Grid>
                            </Expander>

                            <!-- 14. Orderflow & Overlays -->
                            <Expander Header="Orderflow" IsExpanded="True" Style="{StaticResource Nt8PropertyExpander}">
                                <Grid Margin="4,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="200"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="26"/><RowDefinition Height="26"/><RowDefinition Height="26"/><RowDefinition Height="26"/>
                                        <RowDefinition Height="26"/><RowDefinition Height="26"/><RowDefinition Height="26"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Footprint style / mode" Style="{StaticResource Nt8PropLabel}"/>
                                    <ComboBox x:Name="PropOrderflowFootprintMode" Grid.Row="0" Grid.Column="1" Style="{StaticResource DarkComboBox}" Height="23">
                                        <ComboBoxItem Content="Bid x Ask" IsSelected="True"/><ComboBoxItem Content="Bid"/><ComboBoxItem Content="Ask"/><ComboBoxItem Content="Delta"/><ComboBoxItem Content="Volume"/>
                                    </ComboBox>

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Candle line / spine" Style="{StaticResource Nt8PropLabel}"/>
                                    <CheckBox x:Name="PropOrderflowCandleLine" Grid.Row="1" Grid.Column="1" IsChecked="True" VerticalAlignment="Center" Margin="4,0,0,0"/>

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="VWAP + Bands" Style="{StaticResource Nt8PropLabel}"/>
                                    <CheckBox x:Name="PropOrderflowVwap" Grid.Row="2" Grid.Column="1" IsChecked="True" VerticalAlignment="Center" Margin="4,0,0,0"/>

                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="CVD curve" Style="{StaticResource Nt8PropLabel}"/>
                                    <CheckBox x:Name="PropOrderflowCvd" Grid.Row="3" Grid.Column="1" IsChecked="True" VerticalAlignment="Center" Margin="4,0,0,0"/>

                                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Calculation mode" Style="{StaticResource Nt8PropLabel}"/>
                                    <ComboBox x:Name="PropOrderflowCalculationMode" Grid.Row="4" Grid.Column="1" Style="{StaticResource DarkComboBox}" Height="23">
                                        <ComboBoxItem Content="UpDownTick" IsSelected="True"/><ComboBoxItem Content="BidAskSpread"/>
                                    </ComboBox>

                                    <TextBlock Grid.Row="5" Grid.Column="0" Text="Spread trades" Style="{StaticResource Nt8PropLabel}"/>
                                    <ComboBox x:Name="PropOrderflowSpreadTrades" Grid.Row="5" Grid.Column="1" Style="{StaticResource DarkComboBox}" Height="23">
                                        <ComboBoxItem Content="Split" IsSelected="True"/><ComboBoxItem Content="Ignore"/>
                                    </ComboBox>

                                    <TextBlock Grid.Row="6" Grid.Column="0" Text="Reconstruct tape" Style="{StaticResource Nt8PropLabel}"/>
                                    <CheckBox x:Name="PropOrderflowReconstructTape" Grid.Row="6" Grid.Column="1" IsChecked="False" VerticalAlignment="Center" Margin="4,0,0,0"/>
                                </Grid>
                            </Expander>

                            <!-- 15. General -->
                            <Expander Header="General" IsExpanded="False" Style="{StaticResource Nt8PropertyExpander}">
                                <Grid Margin="4,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="200"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="26"/><RowDefinition Height="26"/><RowDefinition Height="26"/><RowDefinition Height="26"/>
                                        <RowDefinition Height="26"/><RowDefinition Height="26"/><RowDefinition Height="26"/><RowDefinition Height="26"/>
                                        <RowDefinition Height="26"/><RowDefinition Height="26"/><RowDefinition Height="26"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Show price line" Style="{StaticResource Nt8PropLabel}"/>
                                    <CheckBox x:Name="PropGeneralShowPriceLine" Grid.Row="0" Grid.Column="1" IsChecked="False" VerticalAlignment="Center" Margin="4,0,0,0"/>

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="▶ Price line" Style="{StaticResource Nt8PropLabel}"/>
                                    <TextBox Grid.Row="1" Grid.Column="1" Text="Dot, 1px" Style="{StaticResource Nt8PropTextBox}" IsReadOnly="True"/>

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Non-Crypto volumes d..." Style="{StaticResource Nt8PropLabel}"/>
                                    <TextBox x:Name="PropGeneralNonCryptoDivider" Grid.Row="2" Grid.Column="1" Text="1" Style="{StaticResource Nt8PropTextBox}"/>

                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Crypto force instrument" Style="{StaticResource Nt8PropLabel}"/>
                                    <CheckBox x:Name="PropGeneralCryptoForce" Grid.Row="3" Grid.Column="1" IsChecked="False" VerticalAlignment="Center" Margin="4,0,0,0"/>

                                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Crypto decimal places" Style="{StaticResource Nt8PropLabel}"/>
                                    <TextBox x:Name="PropGeneralCryptoDecimals" Grid.Row="4" Grid.Column="1" Text="2" Style="{StaticResource Nt8PropTextBox}"/>

                                    <TextBlock Grid.Row="5" Grid.Column="0" Text="Working time" Style="{StaticResource Nt8PropLabel}"/>
                                    <CheckBox x:Name="PropGeneralWorkingTime" Grid.Row="5" Grid.Column="1" IsChecked="False" VerticalAlignment="Center" Margin="4,0,0,0"/>

                                    <TextBlock Grid.Row="6" Grid.Column="0" Text="Smooth render" Style="{StaticResource Nt8PropLabel}"/>
                                    <CheckBox x:Name="PropGeneralSmoothRender" Grid.Row="6" Grid.Column="1" IsChecked="False" VerticalAlignment="Center" Margin="4,0,0,0"/>

                                    <TextBlock Grid.Row="7" Grid.Column="0" Text="Hint" Style="{StaticResource Nt8PropLabel}"/>
                                    <CheckBox x:Name="PropGeneralHint" Grid.Row="7" Grid.Column="1" IsChecked="True" VerticalAlignment="Center" Margin="4,0,0,0"/>

                                    <TextBlock Grid.Row="8" Grid.Column="0" Text="Warning" Style="{StaticResource Nt8PropLabel}"/>
                                    <CheckBox x:Name="PropGeneralWarning" Grid.Row="8" Grid.Column="1" IsChecked="True" VerticalAlignment="Center" Margin="4,0,0,0"/>

                                    <TextBlock Grid.Row="9" Grid.Column="0" Text="Version" Style="{StaticResource Nt8PropLabel}"/>
                                    <CheckBox x:Name="PropGeneralVersion" Grid.Row="9" Grid.Column="1" IsChecked="True" VerticalAlignment="Center" Margin="4,0,0,0"/>

                                    <TextBlock Grid.Row="10" Grid.Column="0" Text="Log" Style="{StaticResource Nt8PropLabel}"/>
                                    <CheckBox x:Name="PropGeneralLog" Grid.Row="10" Grid.Column="1" IsChecked="True" VerticalAlignment="Center" Margin="4,0,0,0"/>
                                </Grid>
                            </Expander>

                            <!-- 16. Licensing -->
                            <Expander Header="Licensing" IsExpanded="False" Style="{StaticResource Nt8PropertyExpander}">
                                <Grid Margin="4,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="200"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="26"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Hardware Id" Style="{StaticResource Nt8PropLabel}"/>
                                    <TextBox Grid.Row="0" Grid.Column="1" Text="AK10X-NT8-8742-99B1" Style="{StaticResource Nt8PropTextBox}" IsReadOnly="True"/>
                                </Grid>
                            </Expander>

                            <!-- 17. Data Series -->
                            <Expander Header="Data Series" IsExpanded="False" Style="{StaticResource Nt8PropertyExpander}">
                                <Grid Margin="4,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="200"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="26"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Input series" Style="{StaticResource Nt8PropLabel}"/>
                                    <TextBox x:Name="PropDataSeriesInput" Grid.Row="0" Grid.Column="1" Text="TATASTEEL_I (5 Minute)" Style="{StaticResource Nt8PropTextBox}" IsReadOnly="True"/>
                                </Grid>
                            </Expander>

                            <!-- 18. Visual -->
                            <Expander Header="Visual" IsExpanded="False" Style="{StaticResource Nt8PropertyExpander}">
                                <Grid Margin="4,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="200"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="26"/><RowDefinition Height="26"/><RowDefinition Height="26"/><RowDefinition Height="26"/>
                                        <RowDefinition Height="26"/><RowDefinition Height="26"/><RowDefinition Height="26"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Auto scale" Style="{StaticResource Nt8PropLabel}"/>
                                    <CheckBox x:Name="PropVisualAutoScale" Grid.Row="0" Grid.Column="1" IsChecked="True" VerticalAlignment="Center" Margin="4,0,0,0"/>

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Displacement" Style="{StaticResource Nt8PropLabel}"/>
                                    <TextBox x:Name="PropVisualDisplacement" Grid.Row="1" Grid.Column="1" Text="0" Style="{StaticResource Nt8PropTextBox}"/>

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Display in Data Box" Style="{StaticResource Nt8PropLabel}"/>
                                    <CheckBox x:Name="PropVisualDisplayInDataBox" Grid.Row="2" Grid.Column="1" IsChecked="True" VerticalAlignment="Center" Margin="4,0,0,0"/>

                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Panel" Style="{StaticResource Nt8PropLabel}"/>
                                    <ComboBox x:Name="PropVisualPanel" Grid.Row="3" Grid.Column="1" Style="{StaticResource DarkComboBox}" Height="23">
                                        <ComboBoxItem Content="Same as input series" IsSelected="True"/>
                                    </ComboBox>

                                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Price marker(s)" Style="{StaticResource Nt8PropLabel}"/>
                                    <CheckBox x:Name="PropVisualPriceMarkers" Grid.Row="4" Grid.Column="1" IsChecked="True" VerticalAlignment="Center" Margin="4,0,0,0"/>

                                    <TextBlock Grid.Row="5" Grid.Column="0" Text="Scale justification" Style="{StaticResource Nt8PropLabel}"/>
                                    <ComboBox x:Name="PropVisualScaleJustification" Grid.Row="5" Grid.Column="1" Style="{StaticResource DarkComboBox}" Height="23">
                                        <ComboBoxItem Content="Right" IsSelected="True"/><ComboBoxItem Content="Left"/>
                                    </ComboBox>

                                    <TextBlock Grid.Row="6" Grid.Column="0" Text="Visible" Style="{StaticResource Nt8PropLabel}"/>
                                    <CheckBox x:Name="PropVisualVisible" Grid.Row="6" Grid.Column="1" IsChecked="True" VerticalAlignment="Center" Margin="4,0,0,0"/>
                                </Grid>
                            </Expander>

                            <!-- 19. Setup -->
                            <Expander Header="Setup" IsExpanded="False" Style="{StaticResource Nt8PropertyExpander}">
                                <Grid Margin="4,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="200"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="26"/><RowDefinition Height="26"/><RowDefinition Height="26"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Calculate" Style="{StaticResource Nt8PropLabel}"/>
                                    <ComboBox x:Name="PropSetupCalculate" Grid.Row="0" Grid.Column="1" Style="{StaticResource DarkComboBox}" Height="23">
                                        <ComboBoxItem Content="On each tick" IsSelected="True"/><ComboBoxItem Content="On bar close"/><ComboBoxItem Content="On price change"/>
                                    </ComboBox>

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Label" Style="{StaticResource Nt8PropLabel}"/>
                                    <TextBox x:Name="PropSetupLabel" Grid.Row="1" Grid.Column="1" Text="MZpack.NT8.mzFootprint 3.14.21" Style="{StaticResource Nt8PropTextBox}" IsReadOnly="True"/>

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Maximum bars look back" Style="{StaticResource Nt8PropLabel}"/>
                                    <ComboBox x:Name="PropSetupMaxBarsLookBack" Grid.Row="2" Grid.Column="1" Style="{StaticResource DarkComboBox}" Height="23">
                                        <ComboBoxItem Content="256" IsSelected="True"/><ComboBoxItem Content="512"/><ComboBoxItem Content="1024"/><ComboBoxItem Content="Unlimited"/>
                                    </ComboBox>
                                </Grid>
                            </Expander>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Row 3: Action Buttons Bar -->
                    <Border Grid.Row="3" Background="#26262A" BorderBrush="#1C1C20" BorderThickness="0,1,0,0" Padding="10,6" CornerRadius="0,0,4,4">
                        <Grid>
                            <Button Content="Reset to NT8 Defaults" Style="{StaticResource SmallToolButton}" HorizontalAlignment="Left" Click="ResetPropertiesToNt8_Click"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="Apply" Style="{StaticResource SmallToolButton}" Margin="0,0,6,0" Click="ApplyProperties_Click"/>
                                <Button Content="OK" Style="{StaticResource SmallToolButton}" Background="#2563EB" BorderBrush="#3B82F6" Foreground="#FFFFFF" FontWeight="Bold" Margin="0,0,6,0" Click="OkProperties_Click"/>
                                <Button Content="Cancel" Style="{StaticResource SmallToolButton}" Click="CloseProperties_Click"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- Symbol Search Modal -->
        <Grid x:Name="SymbolSearchModal" Grid.RowSpan="5" Background="#D0050508" Visibility="Collapsed" Panel.ZIndex="2000">
            <Border Width="500" MaxHeight="550" Background="#18181B" BorderBrush="#3F3F46" BorderThickness="1" CornerRadius="8" Padding="0" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <Border Grid.Row="0" Background="#1E1E24" BorderBrush="#27272A" BorderThickness="0,0,0,1" Padding="14,10" CornerRadius="8,8,0,0">
                        <Grid>
                            <TextBlock Text="🔎 NinjaTrader 8 Instrument Search (Accelpix EQ &amp; Futures)" Foreground="#FFFFFF" FontWeight="Bold" FontSize="13" VerticalAlignment="Center"/>
                            <Button Content="✕" Style="{StaticResource SmallToolButton}" HorizontalAlignment="Right" Width="26" Height="24" Padding="0" Click="CloseSymbolSearch_Click"/>
                        </Grid>
                    </Border>

                    <!-- Search Input Box -->
                    <Border Grid.Row="1" Padding="14,10,14,6" Background="#141416">
                        <TextBox x:Name="SymbolSearchQueryBox" Background="#1E1E24" Foreground="#FFFFFF" BorderBrush="#3B82F6" BorderThickness="1.5"
                                 Padding="8,6" FontSize="12" FontFamily="Segoe UI" TextChanged="SymbolSearchQueryBox_TextChanged"
                                 Tag="Type symbol (e.g. NIFTY, BANKNIFTY, HDFCLIFE, RELIANCE, TCS)..."/>
                    </Border>

                    <!-- Search Results List -->
                    <ListBox x:Name="SymbolSearchResultsList" Grid.Row="2" Background="#18181B" BorderThickness="0" Margin="10,4"
                             MouseDoubleClick="SymbolSearchResultsList_MouseDoubleClick">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="#27272A" BorderThickness="0,0,0,1" Padding="8,6" Background="Transparent">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="130"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Symbol}" FontWeight="Bold" Foreground="#38BDF8" FontSize="12"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Name}" Foreground="#E4E4E7" FontSize="11" TextTrimming="CharacterEllipsis"/>
                                        <Border Grid.Column="2" Background="#1E293B" CornerRadius="3" Padding="6,2">
                                            <TextBlock Text="{Binding Category}" Foreground="#94A3B8" FontSize="10"/>
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- Footer -->
                    <Border Grid.Row="3" Background="#1E1E24" BorderBrush="#27272A" BorderThickness="0,1,0,0" Padding="14,8" CornerRadius="0,0,8,8">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="Select &amp; Open" Style="{StaticResource SmallToolButton}" Background="#2563EB" BorderBrush="#3B82F6" Foreground="#FFFFFF" FontWeight="Bold" Margin="0,0,8,0" Click="SelectSearchedSymbol_Click"/>
                            <Button Content="Cancel" Style="{StaticResource SmallToolButton}" Click="CloseSymbolSearch_Click"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
