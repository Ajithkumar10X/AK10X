<UserControl x:Class="WindowsApp.Ninja.Views.NinjaConnectionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1100"
             Background="#0B1120" Foreground="#F8FAFC">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <!-- Header -->
            <RowDefinition Height="Auto"/>
            <!-- Account Cards -->
            <RowDefinition Height="Auto"/>
            <!-- Connections Table -->
            <RowDefinition Height="*"/>
            <!-- REA Clone Info Footer -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 0: Header -->
        <Border Grid.Row="0" Background="#111827" BorderBrush="#1F2937" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="⚡" FontSize="20" Margin="0,0,8,0"/>
                        <TextBlock Text="NinjaTrader 8 Connection Center" FontSize="18" FontWeight="Bold" Foreground="#F8FAFC"/>
                        <Border Background="#1E3A8A" CornerRadius="4" Padding="8,2" Margin="12,0,0,0">
                            <TextBlock Text="CLONED VIA REA" Foreground="#93C5FD" FontSize="10" FontWeight="Bold"/>
                        </Border>
                    </StackPanel>
                    <TextBlock Text="Configured providers, accounts, and market data feeds extracted from C:\Users\AK\Documents\NinjaTrader 8\Config.xml" 
                               Foreground="#94A3B8" FontSize="12" Margin="0,4,0,0"/>
                </StackPanel>

                <!-- Status Badge -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border x:Name="ActiveStatusBadge" Background="#064E3B" BorderBrush="#059669" BorderThickness="1" CornerRadius="6" Padding="12,6">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="StatusDot" Width="10" Height="10" Fill="#10B981" Margin="0,0,8,0"/>
                            <TextBlock x:Name="ActiveStatusText" Text="Connected: My NinjaTrader (Simulation)" Foreground="#D1FAE5" FontWeight="Bold" FontSize="12"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 1: Live Account Balances & Metrics -->
        <Grid Grid.Row="1" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Cash Balance Card -->
            <Border Grid.Column="0" Background="#111827" BorderBrush="#1F2937" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,8,0">
                <StackPanel>
                    <TextBlock Text="CASH BALANCE (Sim101)" Foreground="#94A3B8" FontSize="11" FontWeight="SemiBold"/>
                    <TextBlock x:Name="CashBalanceText" Text="$100,000.00" Foreground="#38BDF8" FontSize="22" FontWeight="Bold" Margin="0,6,0,0"/>
                    <TextBlock Text="Denomination: USD" Foreground="#64748B" FontSize="10" Margin="0,2,0,0"/>
                </StackPanel>
            </Border>

            <!-- Buying Power Card -->
            <Border Grid.Column="1" Background="#111827" BorderBrush="#1F2937" BorderThickness="1" CornerRadius="8" Padding="14" Margin="4,0,8,0">
                <StackPanel>
                    <TextBlock Text="BUYING POWER" Foreground="#94A3B8" FontSize="11" FontWeight="SemiBold"/>
                    <TextBlock x:Name="BuyingPowerText" Text="$400,000.00" Foreground="#F8FAFC" FontSize="22" FontWeight="Bold" Margin="0,6,0,0"/>
                    <TextBlock Text="4x Intraday Leverage" Foreground="#64748B" FontSize="10" Margin="0,2,0,0"/>
                </StackPanel>
            </Border>

            <!-- Realized P&L Card -->
            <Border Grid.Column="2" Background="#111827" BorderBrush="#1F2937" BorderThickness="1" CornerRadius="8" Padding="14" Margin="4,0,8,0">
                <StackPanel>
                    <TextBlock Text="REALIZED P&amp;L" Foreground="#94A3B8" FontSize="11" FontWeight="SemiBold"/>
                    <TextBlock x:Name="RealizedPnlText" Text="+$1,420.50" Foreground="#34D399" FontSize="22" FontWeight="Bold" Margin="0,6,0,0"/>
                    <TextBlock Text="Session Closed Trades" Foreground="#64748B" FontSize="10" Margin="0,2,0,0"/>
                </StackPanel>
            </Border>

            <!-- Unrealized P&L Card -->
            <Border Grid.Column="3" Background="#111827" BorderBrush="#1F2937" BorderThickness="1" CornerRadius="8" Padding="14" Margin="8,0,0,0">
                <StackPanel>
                    <TextBlock Text="UNREALIZED P&amp;L" Foreground="#94A3B8" FontSize="11" FontWeight="SemiBold"/>
                    <TextBlock x:Name="UnrealizedPnlText" Text="+$385.00" Foreground="#34D399" FontSize="22" FontWeight="Bold" Margin="0,6,0,0"/>
                    <TextBlock Text="Active Positions Open" Foreground="#64748B" FontSize="10" Margin="0,2,0,0"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- 2: Connections List Table -->
        <Border Grid.Row="2" Background="#111827" BorderBrush="#1F2937" BorderThickness="1" CornerRadius="8" Padding="16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,12">
                    <TextBlock Text="Configured Connections (REA Cloned)" FontSize="14" FontWeight="Bold" Foreground="#F8FAFC"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="🔄 Refresh Status" Background="#1F2937" Foreground="#E2E8F0" BorderThickness="0" Padding="10,4" Margin="0,0,8,0" Click="RefreshConnections_Click"/>
                        <Button Content="➕ Add Connection" Background="#2563EB" Foreground="#FFFFFF" BorderThickness="0" Padding="10,4" Click="AddConnection_Click"/>
                    </StackPanel>
                </Grid>

                <DataGrid x:Name="ConnectionsGrid" Grid.Row="1" AutoGenerateColumns="False" 
                          CanUserAddRows="False" HeadersVisibility="Column" 
                          Background="Transparent" RowBackground="#0E1726" AlternatingRowBackground="#111C2E"
                          BorderThickness="0" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#1E293B"
                          Foreground="#F8FAFC" FontSize="13" SelectionMode="Single" RowHeight="44">
                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="#1E293B"/>
                            <Setter Property="Foreground" Value="#94A3B8"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="Padding" Value="14,10"/>
                            <Setter Property="BorderThickness" Value="0,0,0,1"/>
                            <Setter Property="BorderBrush" Value="#334155"/>
                        </Style>
                    </DataGrid.ColumnHeaderStyle>
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <Setter Property="Height" Value="44"/>
                            <Setter Property="VerticalContentAlignment" Value="Center"/>
                        </Style>
                    </DataGrid.RowStyle>
                    <DataGrid.CellStyle>
                        <Style TargetType="DataGridCell">
                            <Setter Property="VerticalAlignment" Value="Center"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                        </Style>
                    </DataGrid.CellStyle>
                    <DataGrid.Columns>
                        <!-- Status Indicator -->
                        <DataGridTemplateColumn Header="Status" Width="130">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0">
                                        <Ellipse Width="9" Height="9" Fill="{Binding StatusBadgeColor}" Margin="0,0,8,0"/>
                                        <TextBlock Text="{Binding Status}" FontWeight="SemiBold" Foreground="{Binding StatusBadgeColor}" FontSize="12"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Connection Name -->
                        <DataGridTemplateColumn Header="Connection Name" Width="220">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}" FontWeight="Bold" Foreground="#F8FAFC" VerticalAlignment="Center" Margin="14,0" FontSize="12.5"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Provider -->
                        <DataGridTemplateColumn Header="Provider" Width="280">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Provider}" Foreground="#CBD5E1" VerticalAlignment="Center" Margin="14,0" FontSize="12"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Feed Type -->
                        <DataGridTemplateColumn Header="Data Feed Type" Width="260">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding FeedType}" Foreground="#94A3B8" VerticalAlignment="Center" Margin="14,0" FontSize="12"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Latency / Ping -->
                        <DataGridTemplateColumn Header="Latency" Width="100">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding LatencyMs, StringFormat='{}{0} ms'}" Foreground="#38BDF8" FontWeight="SemiBold" VerticalAlignment="Center" Margin="14,0" FontSize="12"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Action Button -->
                        <DataGridTemplateColumn Header="Action" Width="130">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="{Binding ActionText}" 
                                            Background="{Binding ActionBgColor}"
                                            Foreground="#FFFFFF"
                                            BorderThickness="0"
                                            Tag="{Binding Name}" Click="ToggleConnectBtn_Click"
                                            Padding="16,6" Margin="8,4" FontWeight="SemiBold" FontSize="11" Cursor="Hand">
                                        <Button.Resources>
                                            <Style TargetType="Border">
                                                <Setter Property="CornerRadius" Value="4"/>
                                            </Style>
                                        </Button.Resources>
                                    </Button>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <!-- 3: REA Info Footer -->
        <Border Grid.Row="3" Background="#0F172A" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,16,0,0">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="🔗 REA Bridge Target:" Foreground="#64748B" FontSize="11" Margin="0,0,6,0"/>
                    <TextBlock Text="D:\AK10X\rea\ninja-full-clone-schema.json" Foreground="#38BDF8" FontSize="11" FontWeight="SemiBold"/>
                </StackPanel>
                <TextBlock Text="NinjaTrader 8 Core v8.1.5.2 • Tradovate / Kinetick / Accelpix / OpenConnect Supported" 
                           Foreground="#64748B" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
